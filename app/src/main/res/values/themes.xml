<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ImageOpt" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ui_accent</item>
        <item name="colorOnPrimary">@color/ui_white</item>
        <item name="colorPrimaryContainer">@color/ui_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/ui_accent</item>
        <item name="colorSecondary">@color/ui_text</item>
        <item name="colorSurface">@color/ui_surface</item>
        <item name="colorOnSurface">@color/ui_text</item>
        <item name="colorOnSurfaceVariant">@color/ui_muted</item>
        <item name="colorOutline">@color/ui_control_outline</item>
        <item name="android:colorBackground">@color/ui_background</item>
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:navigationBarColor">@color/ui_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="materialButtonStyle">@style/Widget.ImageOpt.Button</item>
        <item name="radioButtonStyle">@style/Widget.ImageOpt.RadioButton</item>
    </style>
    <style name="Widget.ImageOpt.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>
    <style name="Widget.ImageOpt.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="strokeColor">@color/ui_control_outline</item>
        <item name="backgroundTint">@color/ui_surface</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="Widget.ImageOpt.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">24dp</item>
    </style>
    <style name="Widget.ImageOpt.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/ui_surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/ui_outline</item>
    </style>
    <style name="Widget.ImageOpt.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:singleLine">false</item>
    </style>
    <style name="TextAppearance.ImageOpt.Heading" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.ImageOpt.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="TextAppearance.ImageOpt.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>
